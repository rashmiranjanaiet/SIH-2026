# Required production settings - never commit real values.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/sih_aryan_2026?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated when the website is hosted on GitHub Pages and locally.
CLIENT_URL=https://<github-username>.github.io/<repository-name>,http://localhost:5000

# Create the first administrator with `npm run seed`.
ADMIN_NAME=SIH Portal Administrator
ADMIN_EMAIL=admin@aryan.edu.in
ADMIN_PASSWORD=change-this-before-seeding

# Required for photo and PDF uploads (use a Cloudinary unsigned preset only if you implement direct client uploads).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
